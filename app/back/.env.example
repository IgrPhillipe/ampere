# PostgreSQL JDBC URL. Note the jdbc: prefix — Spring does not accept the
# postgresql://user:password@host/database form.
DATABASE_URL=jdbc:postgresql://localhost:5432/ampere
DATABASE_USER=ampere
DATABASE_PASSWORD=ampere

# API port.
SERVER_PORT=8080

# Front-end origin, used in the verification link and QR code of the documents.
FRONT_URL=http://localhost:5173

# PKCS12 that signs the memorials, in base64, and its password. Required with the
# prod profile. Left empty elsewhere, the API signs with a certificate generated at
# each start. Never commit a real key. See docs/tecnico/assinatura-documentos.md.
SIGNING_KEYSTORE=
SIGNING_KEYSTORE_PASSWORD=

# Used by docker-compose.yml to bring PostgreSQL up.
POSTGRES_USER=ampere
POSTGRES_PASSWORD=ampere
POSTGRES_DB=ampere
POSTGRES_PORT=5432
