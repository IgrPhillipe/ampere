# PostgreSQL JDBC URL. Note the jdbc: prefix — Spring does not accept the
# postgresql://user:password@host/database form.
DATABASE_URL=jdbc:postgresql://localhost:5432/ampere
DATABASE_USER=ampere
DATABASE_PASSWORD=ampere

# API port.
SERVER_PORT=8080

# Used by docker-compose.yml to bring PostgreSQL up.
POSTGRES_USER=ampere
POSTGRES_PASSWORD=ampere
POSTGRES_DB=ampere
POSTGRES_PORT=5432
