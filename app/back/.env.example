# URL JDBC do PostgreSQL. Note o prefixo jdbc: — o Spring não aceita o
# formato postgresql://usuario:senha@host/banco.
DATABASE_URL=jdbc:postgresql://localhost:5432/ampere
DATABASE_USER=ampere
DATABASE_PASSWORD=ampere

# Porta da API.
SERVER_PORT=8080

# Usado pelo docker-compose.yml para subir o PostgreSQL.
POSTGRES_USER=ampere
POSTGRES_PASSWORD=ampere
POSTGRES_DB=ampere
POSTGRES_PORT=5432
