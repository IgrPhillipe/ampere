# API base URL. In development use /api, which Vite proxies to the Spring
# Boot back-end at http://localhost:8080 (see vite.config.ts).
VITE_API_URL=/api

# Where the /api proxy points in development.
# Default: http://localhost:8080 (Spring Boot).
# VITE_PROXY_TARGET=http://localhost:8080

# Liga os mocks do MSW no lugar da API real. Padrao: false.
# O back-end existe e o caminho normal de desenvolvimento e falar com ele:
#   cd app/back && docker compose up -d
# Use true so para mexer no front sem subir o back.
# VITE_ENABLE_MSW=true
