# URL base da API. Em desenvolvimento use /api, que o Vite faz proxy
# para o back-end Spring Boot em http://localhost:8080 (ver vite.config.ts).
VITE_API_URL=/api

# Para onde o proxy de /api aponta em desenvolvimento.
# Padrao: http://localhost:8080 (Spring Boot).
# VITE_PROXY_TARGET=http://localhost:8080
