{
	"files": [],
	"references": [
		{ "path": "./tsconfig.app.json" },
		{ "path": "./tsconfig.node.json" }
	],
	/** Repetidos de tsconfig.app.json: ha ferramenta que le so a raiz. */
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@styles/*": ["./src/styles/*"],
			"@services/*": ["./src/services/*"],
			"@config": ["./src/config"],
			"@config/*": ["./src/config/*"],
			"@lib/*": ["./src/lib/*"],
			"@hooks/*": ["./src/hooks/*"],
			"@components/*": ["./src/components/*"],
			"@features/*": ["./src/features/*"],
			"@routes/*": ["./src/routes/*"],
			"@assets/*": ["./src/assets/*"],
			"@providers/*": ["./src/providers/*"]
		}
	}
}
