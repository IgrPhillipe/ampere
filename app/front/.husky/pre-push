# Validates only what changed against the remote. A docs-only push goes straight through.
changed() { ! git diff --quiet "@{upstream}" HEAD -- "$1" 2>/dev/null; }

if changed app/front; then
	(cd app/front && pnpm validate:ci) || exit 1
fi

if changed app/back; then
	(cd app/back && ./mvnw -B -q validate) || exit 1
fi
