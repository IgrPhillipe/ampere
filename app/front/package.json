	},
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"type-check": "tsc -b --noEmit",
		"lint": "biome check . && eslint .",
		"lint:fix": "biome check --write . && eslint . --fix",
		"lint:biome": "biome check .",
		"lint:eslint": "eslint .",
		"format": "biome format --write .",
		"preview": "vite preview",
		"prepare": "cd ../.. && husky app/front/.husky",
		"validate": "pnpm format && pnpm lint:fix && pnpm type-check"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@fontsource-variable/ibm-plex-sans": "^5.2.8",
		"@hookform/resolvers": "^5.4.0",
		"@tailwindcss/vite": "^4.3.1",
		"@tanstack/react-query": "^5.101.1",
		"@tanstack/react-router": "1.170.16",
		"@tanstack/react-table": "^9.2.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.3.0",
		"dayjs": "^1.11.21",
		"ky": "^2.0.2",
		"lucide-react": "^1.21.0",
		"nuqs": "^2.10.1",
		"radix-ui": "^1.6.7",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-error-boundary": "^6.1.5",
		"react-hook-form": "^7.80.0",
		"shadcn": "^4.11.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.1",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@biomejs/biome": "2.5.1",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tanstack/router-plugin": "^1.168.18",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^24.13.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^10.5.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.3",
		"eslint-plugin-unused-imports": "^4.4.1",
		"husky": "^9.1.7",
		"msw": "^2.14.6",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.61.0",
		"vite": "^8.1.0"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	},
	"description": "Front-end do AMPERE — interface do projetista e do analista.",
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": ">=24"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"msw"
		]
	}
}
